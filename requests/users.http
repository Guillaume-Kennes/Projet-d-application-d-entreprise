@baseUrl = http://localhost:3000

### Login a user
POST {{baseUrl}}/auths/login
Content-Type: application/json

{
  "email":"Caroline.line@student.vinci.be",
  "password":"mdpuser.1"
}
> {%
  client.global.set("carolineToken", response.body.token);
%}

