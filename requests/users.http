### Get all users with a student token
GET {{baseUrl}}/users/getAllUsers
Authorization: {{carolineToken}}

### Get all users with a teacher token
GET {{baseUrl}}/users/getAllUsers
Authorization: {{leleuxToken}}

### Get all users with an admin token
GET {{baseUrl}}/users/getAllUsers
Authorization: {{annouckToken}}

### Register an user
POST {{baseUrl}}/auths/register
Content-Type: application/json

{
  "email": "ryuyuer@student.vinci.be",
  "password": "mdp1",
  "lastName": "test",
  "firstName": "TEST",
  "phoneNumber": "0546546545",
  "role": "Student",
  "versionNumber": 1
}

### Get all students with an internship
GET {{baseUrl}}/users/getStudentsWithInternship/2023-2024
Content-Type: application/json
Authorization: {{leleuxToken}}

### Get all students without an internship
GET {{baseUrl}}/users/getStudentsWithoutInternship/2023-2024
Content-Type: application/json
Authorization: {{leleuxToken}}


### Get all contacts of an user by it's id
GET {{baseUrl}}/contacts/5
Content-Type: application/json
Authorization: {{carolineToken}}


### Get an user by it's id
GET {{baseUrl}}/users/5
Authorization: {{carolineToken}}


### Get students by academic year 2023-2024
GET {{baseUrl}}/users/getStudentsByAcademicYear/2023-2024
Authorization: {{leleuxToken}}

### Get students by academic year 2022-2023
GET {{baseUrl}}/users/getStudentsByAcademicYear/2022-2023
Authorization: {{leleuxToken}}

### Get students by academic year 2021-2022
GET {{baseUrl}}/users/getStudentsByAcademicYear/2021-2022
Authorization: {{leleuxToken}}